diff --git a/bootstrap.common.bake b/bootstrap.common.bake
new file mode 100644
index 0000000..f86d986
--- /dev/null
+++ b/bootstrap.common.bake
@@ -0,0 +1,34 @@
+: all after
+
+= M2LIBC ../M2libc
+= TOOLS ../${ARCH_DIR}/bin
+= BINDIR ../${ARCH_DIR}/bin
+= BUILDDIR ../${ARCH_DIR}/artifact
+= TMPDIR ../${ARCH_DIR}/artifact
+= OPERATING_SYSTEM Linux
+
+: mescc-tools-full
+./${ARCH_DIR}/bin/bake --file mescc-tools-full.bake all
+
+: mescc-tools-extra mescc-tools-full
+export TMPDIR ${TMPDIR}
+cd mescc-tools-extra
+${BINDIR}/bake --file mescc-tools-extra.bake tools
+cd ..
+
+: M2-Planet-pr mescc-tools-extra
+./${ARCH_DIR}/bin/bake --file mescc-tools-full.bake M2-Planet-pr
+
+: wrap M2-Planet-pr
+cd mescc-tools-extra
+${BINDIR}/bake --file mescc-tools-extra.bake wrap
+cd ..
+
+: M2-Planet wrap
+./${ARCH_DIR}/bin/bake --file mescc-tools-full.bake M2-Planet
+
+: check M2-Planet
+./${ARCH_DIR}/bin/sha256sum -c ${ARCH}.answers
+
+: after check
+./${ARCH_DIR}/bin/bake --file ./after.bake all
