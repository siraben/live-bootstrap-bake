-/* Function to find a character in a string */
-char* find_char(char* string, char a)
-{
-	if(0 == string[0])
-	{
-		return NULL;
-	}
-
-	while(a != string[0])
-	{
-		string = string + 1;
-
-		if(0 == string[0])
-		{
-			return string;
-		}
-	}
-
-	return string;
-}
-
-/* Function to find the length of a char**; an array of strings */
-int array_length(char** array)
-{
-	int length = 0;
-
-	while(array[length] != NULL)
-	{
-		length = length + 1;
-	}
-
-	return length;
-}
