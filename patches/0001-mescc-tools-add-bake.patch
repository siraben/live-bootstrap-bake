+++ b/test/bake.sh
@@ -0,0 +1,80 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Exercise the replacement recipe runner, not the removed kaem language.
+set -eu
+BAKE=${BAKE:-"$(pwd)/bin/bake"}
+work=$(mktemp -d)
+trap 'rm -rf "$work"' 0
+export TEST_DIRECTORY="$work/subdirectory"
+mkdir "$TEST_DIRECTORY"
+export BAKE_CHECK="$work/check.sh"
+cat > "$BAKE_CHECK" <<'EOF'
+set -eu
+case $1 in
+    fields) shift; test "$#" = 2; test "$1" = two; test "$2" = words ;;
+    empty) shift; test "$#" = 1; test -z "$1" ;;
+    env) test "$COPIED" = 'two words' ;;
+    dir) test "$(pwd)" = "$TEST_DIRECTORY" ;;
+esac
+EOF
+cat > "$work/success.bake" <<'EOF'
+= VALUE two words
+= SWITCH yes
+: all left right grouped-a grouped-b one.out conditions fields environment directory
+: left common
+echo left
+: right common
+echo right
+: common
+echo common
+: grouped-a grouped-b :
+echo $@
+: %.out %.in
+echo $@ $<
+: conditions
+? SWITCH yes echo matched
+! SWITCH yes false
+? SWITCH no false
+! SWITCH no echo unmatched
+! BAKE_TEST_UNSET anything echo unset
+: fields
+/bin/sh ${BAKE_CHECK} fields ${VALUE}
+/bin/sh ${BAKE_CHECK} empty ${BAKE_TEST_UNSET}
+echo ${VALUE}
+: environment
+export COPIED ${VALUE}
+/bin/sh ${BAKE_CHECK} env
+: directory
+cd ${TEST_DIRECTORY}
+/bin/sh ${BAKE_CHECK} dir
+EOF
+unset BAKE_TEST_UNSET
+"$BAKE" --file "$work/success.bake" all > "$work/actual"
+printf '%s\n' common left right grouped-a grouped-b 'one.out one.in' matched unmatched unset 'two words' > "$work/expected"
+cmp "$work/expected" "$work/actual"
+# Select a target explicitly rather than running the default target.
+"$BAKE" -f "$work/success.bake" right > "$work/actual"
+printf '%s\n' common right > "$work/expected"
+cmp "$work/expected" "$work/actual"
+expect_failure() {
+    if "$BAKE" -f "$work/bad.bake" "$1" > "$work/error" 2>&1; then
+        printf 'unexpected success: %s\n' "$2" >&2
+        exit 1
+    else
+        status=$?
+        test "$status" -lt 128
+    fi
+}
+printf ': a b\n: b a\n' > "$work/bad.bake"
+expect_failure a cycle
+printf ': all\nfalse\n' > "$work/bad.bake"
+expect_failure all command-failure
+printf ': all\n' > "$work/bad.bake"
+expect_failure missing unknown-target
+printf ': all\ncd\n' > "$work/bad.bake"
+expect_failure all missing-cd-argument
+printf ': all\nexport\n' > "$work/bad.bake"
+expect_failure all missing-export-argument
+printf ': all\n? SWITCH\n' > "$work/bad.bake"
+expect_failure all malformed-condition
+printf 'bake regression tests: OK\n'
