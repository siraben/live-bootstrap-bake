+check_result()
+{
+	name=$1
+	input=$2
+	expected=$3
+	for target in $targets; do
+		printf '%s\n' "$input" > "$tmp/$name.c"
+		"$QEMU" "$target" "$tmp/$name.c" "$tmp/$name.M1"
+		"$M1" --little-endian --architecture aarch64 \
+			-f aarch64_defs.M1 -f libc-core.M1 -f "$tmp/$name.M1" -o "$tmp/$name.hex2"
+		"$HEX2" --little-endian --architecture aarch64 --base-address 0x100000 \
+			-f ELF-aarch64.hex2 -f "$tmp/$name.hex2" -o "$tmp/$name"
+		chmod +x "$tmp/$name"
+		if "$QEMU" "$tmp/$name"; then status=0; else status=$?; fi
+		test "$status" -eq "$expected"
+	done
+}
+
+# Token guards must preserve live type pointers and other x0 operands.
+check_result global-index 'char*p;int main(){p="Z";return p[0];}' 90
+check_result local-index 'int main(){char*p;p="A";return p[0];}' 65
+
