: all build checksum

: build
checksum-transcriber sources
sha256sum -c sources.SHA256SUM
mkdir build
cd build
ungz --file ${DISTFILES}/${pkg}.tar.gz --output ${pkg}.tar
untar --file ${pkg}.tar
rm ${pkg}.tar
cd ${pkg}
cp ../../files/custom_config.h include/fiwix
cp ../../files/custom_limits.h include/fiwix
cp ../../files/custom_kernel.h include/fiwix
cp ../../files/custom_system.h include/fiwix
simple-patch -Np1 -i ../../patches/live-bootstrap-make.patch
export CONFFLAGS -DCUSTOM_CONFIG_H -DCUSTOM_LIMITS_H -DCUSTOM_KERNEL_H -DCUSTOM_SYSTEM_H
make CCEXE=tcc TEXTADDR=0x80100000 TOPDIR=/${SRCDIR}/${pkg}/build/${pkg}
mkdir /boot
cp fiwix /boot/fiwix
chmod 755 /boot/fiwix
cd ../..

: checksum build
? UPDATE_CHECKSUMS True sha256sum -o ${pkg}.checksums /boot/fiwix
? UPDATE_CHECKSUMS True cp ${pkg}.checksums ${SRCDIR}
! UPDATE_CHECKSUMS True sha256sum -c ${pkg}.checksums
